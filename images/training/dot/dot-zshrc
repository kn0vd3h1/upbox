function ahead_behind {
    curr_branch=$(git rev-parse --abbrev-ref HEAD);
    curr_remote=$(git config branch.$curr_branch.remote);
    curr_merge_branch=$(git config branch.$curr_branch.merge | cut -d / -f 3);
    git rev-list --left-right --count $curr_branch...$curr_remote/$curr_merge_branch | tr -s '\t' '|';
}

# get up cli
function get-up () {
        tempdir=$(mktemp -d)
        pushd ${tempdir}
        VERSION=${1:-current}
        curl -sL https://cli.upbound.io | VERSION=${VERSION} bash > /dev/null
	UPVERSION=$(./up version|head -1|cut -f2 -d:|tr -d " ")
	actversion=""
	if [[ ${UPVERSION} == "v0"* ]]; then
	   actversion=${UPVERSION}
        else
	    actversion=$(./up version --format=json 2>/dev/null | jq -r .client.version)
	fi
        if [[ ${actversion} == "" ]]
        then
                actversion=$(./up version 2>/dev/null |grep '^Client Version' | awk '{print $3}')
        fi
        mv up $HOME/.local/bin/up-${actversion}
        rehash
        echo "Placed up-${actversion} in ${HOME}/.local/bin/up-${actversion}"
        echo "Happy upping!"
        popd
        rmdir ${tempdir}
}
